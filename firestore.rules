rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Validation helper for Admin Config doc in settings collection
    function isValidAdminConfigDoc(data) {
      return data.keys().hasOnly(['password', 'masterPassword', 'passwordHash', 'updatedAt', 'updatedBy', 'isCustomSet'])
        && (
          ('password' in data && data.password is string && data.password.size() >= 4 && data.password.size() <= 100) ||
          ('masterPassword' in data && data.masterPassword is string && data.masterPassword.size() >= 4 && data.masterPassword.size() <= 100)
        )
        && data.updatedAt is string
        && (!('password' in data) || (data.password is string && data.password.size() <= 100))
        && (!('masterPassword' in data) || (data.masterPassword is string && data.masterPassword.size() <= 100))
        && (!('passwordHash' in data) || (data.passwordHash is string && data.passwordHash.size() <= 200))
        && (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 100))
        && (!('isCustomSet' in data) || data.isCustomSet is bool);
    }

    // Validation helper for Admin Authentication doc
    function isValidAdminAuthDoc(data) {
      return data.keys().hasOnly(['masterPassword', 'password', 'passwordHash', 'updatedAt', 'updatedBy', 'isCustomSet'])
        && (
          ('masterPassword' in data && data.masterPassword is string && data.masterPassword.size() >= 4 && data.masterPassword.size() <= 100) ||
          ('password' in data && data.password is string && data.password.size() >= 4 && data.password.size() <= 100)
        )
        && data.updatedAt is string
        && (!('updatedBy' in data) || data.updatedBy is string)
        && (!('isCustomSet' in data) || data.isCustomSet is bool);
    }

    // Validation helper for Teacher document and credentials
    function isValidTeacherDoc(data) {
      return data.keys().hasOnly([
          'id', 'employeeId', 'fullName', 'email', 'phone', 
          'qualification', 'password', 'isClassTeacherOf', 'assignments', 'updatedAt'
        ])
        && data.id is string
        && data.id.size() >= 1
        && data.employeeId is string
        && data.employeeId.size() >= 1
        && data.fullName is string
        && data.fullName.size() >= 2
        && data.fullName.size() <= 120
        && data.password is string
        && data.password.size() >= 4
        && data.password.size() <= 100
        && data.updatedAt is string
        && (!('email' in data) || data.email is string)
        && (!('phone' in data) || data.phone is string)
        && (!('qualification' in data) || data.qualification is string)
        && (!('isClassTeacherOf' in data) || data.isClassTeacherOf == null || data.isClassTeacherOf is map)
        && (!('assignments' in data) || data.assignments is list);
    }

    // Validation helper for User document (Signup onboarding and status/role assignment)
    function isValidUserDoc(data) {
      return data.keys().hasOnly([
          'id', 'name', 'fullName', 'email', 'phone', 'password', 
          'status', 'assignedRole', 'indexNumber', 'createdAt', 'updatedAt'
        ])
        && data.id is string
        && data.id.size() >= 1
        && data.email is string
        && data.email.size() >= 3
        && data.status in ['pending', 'active', 'rejected']
        && data.assignedRole in ['unassigned', 'teacher', 'student', 'admin']
        && (!('name' in data) || (data.name is string && data.name.size() <= 120))
        && (!('fullName' in data) || (data.fullName is string && data.fullName.size() <= 120))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && (!('password' in data) || (data.password is string && data.password.size() <= 100))
        && (!('indexNumber' in data) || (data.indexNumber is string && data.indexNumber.size() <= 50))
        && (!('createdAt' in data) || data.createdAt is string)
        && (!('updatedAt' in data) || data.updatedAt is string);
    }

    // Settings collection (Admin config settings document: settings/admin_config)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if settingId == 'admin_config' 
        && isValidAdminConfigDoc(request.resource.data);
    }

    // System Settings collection (Admin master credentials)
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if (settingId == 'admin_auth' || settingId == 'admin_config') 
        && (isValidAdminAuthDoc(request.resource.data) || isValidAdminConfigDoc(request.resource.data));
    }

    // Teachers collection (Faculty credentials & assignments)
    match /teachers/{teacherId} {
      allow read: if true;
      allow create: if isValidTeacherDoc(request.resource.data)
        && request.resource.data.id == teacherId;
      allow update: if isValidTeacherDoc(request.resource.data)
        && request.resource.data.id == resource.data.id;
      allow delete: if true;
    }

    // Users collection (Onboarding, pending approvals, and role assignments)
    match /users/{userId} {
      allow read: if true;
      allow create: if isValidUserDoc(request.resource.data)
        && request.resource.data.id == userId;
      allow update: if isValidUserDoc(request.resource.data)
        && request.resource.data.id == resource.data.id;
      allow delete: if true;
    }

    // Validation helper for Mark Submissions (Teacher mark entries and offline IndexedDB persistence)
    function isValidMarkSubmissionDoc(data) {
      return data.keys().hasOnly([
          'id', 'teacherId', 'teacherName', 'subjectId', 'grade', 
          'division', 'term', 'status', 'marks', 'submittedAt', 'updatedAt', 'notes'
        ])
        && data.id is string
        && data.subjectId is string
        && data.grade is number
        && data.division in ['A', 'B', 'C']
        && data.term in [1, 2, 3]
        && data.status in ['draft', 'submitted', 'approved', 'rejected']
        && (!('marks' in data) || data.marks is map);
    }

    // Validation helper for Student records and term marks
    function isValidStudentDoc(data) {
      return data.keys().hasOnly([
          'id', 'indexNumber', 'fullName', 'grade', 'division', 
          'gender', 'medium', 'attendanceRate', 'guardianName', 'contactNumber', 
          'terms', 'rankings', 'createdAt', 'updatedAt'
        ])
        && data.id is string
        && data.id.size() >= 1
        && data.indexNumber is string
        && data.indexNumber.size() >= 1
        && data.fullName is string
        && data.fullName.size() >= 1
        && data.fullName.size() <= 120
        && data.grade is number
        && data.division in ['A', 'B', 'C']
        && (!('gender' in data) || data.gender in ['Male', 'Female'])
        && (!('medium' in data) || data.medium in ['Sinhala', 'Tamil', 'English'])
        && (!('attendanceRate' in data) || data.attendanceRate is number)
        && (!('guardianName' in data) || data.guardianName is string)
        && (!('contactNumber' in data) || data.contactNumber is string)
        && (!('terms' in data) || data.terms is map)
        && (!('rankings' in data) || data.rankings is map)
        && (!('createdAt' in data) || data.createdAt is string)
        && (!('updatedAt' in data) || data.updatedAt is string);
    }

    // Students collection (Student roster and term marks across devices)
    match /students/{studentId} {
      allow read: if true;
      allow create, update: if isValidStudentDoc(request.resource.data)
        && request.resource.data.id == studentId;
      allow delete: if true;
    }

    // Mark Submissions collection (offline mark entry sync)
    match /mark_submissions/{submissionId} {
      allow read: if true;
      allow create, update: if isValidMarkSubmissionDoc(request.resource.data)
        && request.resource.data.id == submissionId;
      allow delete: if true;
    }

    // Validation helper for Curriculum Subjects
    function isValidSubjectDoc(data) {
      return data.keys().hasOnly([
          'id', 'name', 'shortName', 'code', 'applicableGrades', 
          'category', 'assignedTeacherId', 'description', 'updatedAt'
        ])
        && data.id is string
        && data.id.size() >= 1
        && data.name is string
        && data.name.size() >= 1
        && data.shortName is string
        && data.code is string
        && data.applicableGrades is list
        && data.category in ['core', 'basket', 'al_stream']
        && (!('assignedTeacherId' in data) || data.assignedTeacherId is string)
        && (!('description' in data) || data.description is string)
        && (!('updatedAt' in data) || data.updatedAt is string);
    }

    // Subjects collection (Curriculum subjects synced across devices)
    match /subjects/{subjectId} {
      allow read: if true;
      allow create, update: if isValidSubjectDoc(request.resource.data)
        && request.resource.data.id == subjectId;
      allow delete: if true;
    }

    // Validation helper for System & RBAC Audit Logs
    function isValidAuditLogDoc(data) {
      return data.keys().hasOnly([
          'id', 'timestamp', 'actorName', 'actorRole', 'actorIdentifier', 
          'action', 'actionTitle', 'details', 'targetEntity', 'grade', 
          'division', 'term', 'severity', 'deviceInfo'
        ])
        && data.id is string
        && data.id.size() >= 1
        && data.timestamp is string
        && data.actorName is string
        && data.actorRole in ['teacher', 'parent', 'student', 'admin', 'system']
        && data.action is string
        && data.actionTitle is string
        && data.details is string
        && data.severity in ['info', 'success', 'warning', 'critical']
        && (!('actorIdentifier' in data) || data.actorIdentifier is string)
        && (!('targetEntity' in data) || data.targetEntity is string)
        && (!('grade' in data) || data.grade is number)
        && (!('division' in data) || data.division is string)
        && (!('term' in data) || data.term is number)
        && (!('deviceInfo' in data) || data.deviceInfo is string);
    }

    // Audit Logs collection (Real-time activity tracking for teachers, parents, and admins)
    match /audit_logs/{logId} {
      allow read: if true;
      allow create, update: if isValidAuditLogDoc(request.resource.data)
        && request.resource.data.id == logId;
      allow delete: if true;
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

