rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Validation helper for Admin Config doc in settings collection
    function isValidAdminConfigDoc(data) {
      return data.keys().hasOnly(['password', 'masterPassword', 'passwordHash', 'updatedAt', 'updatedBy', 'isCustomSet'])
        && (
          ('password' in data && data.password is string && data.password.size() >= 4 && data.password.size() <= 100) ||
          ('masterPassword' in data && data.masterPassword is string && data.masterPassword.size() >= 4 && data.masterPassword.size() <= 100)
        )
        && data.updatedAt is string
        && (!('password' in data) || (data.password is string && data.password.size() <= 100))
        && (!('masterPassword' in data) || (data.masterPassword is string && data.masterPassword.size() <= 100))
        && (!('passwordHash' in data) || (data.passwordHash is string && data.passwordHash.size() <= 200))
        && (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 100))
        && (!('isCustomSet' in data) || data.isCustomSet is bool);
    }

    // Validation helper for Admin Authentication doc
    function isValidAdminAuthDoc(data) {
      return data.keys().hasOnly(['masterPassword', 'password', 'passwordHash', 'updatedAt', 'updatedBy', 'isCustomSet'])
        && (
          ('masterPassword' in data && data.masterPassword is string && data.masterPassword.size() >= 4 && data.masterPassword.size() <= 100) ||
          ('password' in data && data.password is string && data.password.size() >= 4 && data.password.size() <= 100)
        )
        && data.updatedAt is string
        && (!('updatedBy' in data) || data.updatedBy is string)
        && (!('isCustomSet' in data) || data.isCustomSet is bool);
    }

    // Validation helper for Teacher document and credentials
    function isValidTeacherDoc(data) {
      return data.keys().hasOnly([
          'id', 'employeeId', 'fullName', 'email', 'phone', 
          'qualification', 'password', 'isClassTeacherOf', 'assignments', 'updatedAt'
        ])
        && data.id is string
        && data.id.size() >= 1
        && data.employeeId is string
        && data.employeeId.size() >= 1
        && data.fullName is string
        && data.fullName.size() >= 2
        && data.fullName.size() <= 120
        && data.password is string
        && data.password.size() >= 4
        && data.password.size() <= 100
        && data.updatedAt is string
        && (!('email' in data) || data.email is string)
        && (!('phone' in data) || data.phone is string)
        && (!('qualification' in data) || data.qualification is string)
        && (!('isClassTeacherOf' in data) || data.isClassTeacherOf == null || data.isClassTeacherOf is map)
        && (!('assignments' in data) || data.assignments is list);
    }

    // Validation helper for User document (Signup onboarding and status/role assignment)
    function isValidUserDoc(data) {
      return data.keys().hasOnly([
          'id', 'name', 'fullName', 'email', 'phone', 'password', 
          'status', 'assignedRole', 'indexNumber', 'createdAt', 'updatedAt'
        ])
        && data.id is string
        && data.id.size() >= 1
        && data.email is string
        && data.email.size() >= 3
        && data.status in ['pending', 'active', 'rejected']
        && data.assignedRole in ['unassigned', 'teacher', 'student', 'admin']
        && (!('name' in data) || (data.name is string && data.name.size() <= 120))
        && (!('fullName' in data) || (data.fullName is string && data.fullName.size() <= 120))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && (!('password' in data) || (data.password is string && data.password.size() <= 100))
        && (!('indexNumber' in data) || (data.indexNumber is string && data.indexNumber.size() <= 50))
        && (!('createdAt' in data) || data.createdAt is string)
        && (!('updatedAt' in data) || data.updatedAt is string);
    }

    // Settings collection (Admin config settings document: settings/admin_config)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if settingId == 'admin_config' 
        && isValidAdminConfigDoc(request.resource.data);
    }

    // System Settings collection (Admin master credentials)
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if (settingId == 'admin_auth' || settingId == 'admin_config') 
        && (isValidAdminAuthDoc(request.resource.data) || isValidAdminConfigDoc(request.resource.data));
    }

    // Teachers collection (Faculty credentials & assignments)
    match /teachers/{teacherId} {
      allow read: if true;
      allow create: if isValidTeacherDoc(request.resource.data)
        && request.resource.data.id == teacherId;
      allow update: if isValidTeacherDoc(request.resource.data)
        && request.resource.data.id == resource.data.id;
      allow delete: if true;
    }

    // Users collection (Onboarding, pending approvals, and role assignments)
    match /users/{userId} {
      allow read: if true;
      allow create: if isValidUserDoc(request.resource.data)
        && request.resource.data.id == userId;
      allow update: if isValidUserDoc(request.resource.data)
        && request.resource.data.id == resource.data.id;
      allow delete: if true;
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
